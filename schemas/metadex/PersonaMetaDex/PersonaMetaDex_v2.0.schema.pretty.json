{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stashkit/schemas/metadex/persona_metadex.schema.v2.0.json",
  "title": "PersonaMetaDex Schema v2.0 (MetaDex v2)",
  "description": "A MetaDex specialization for defining reusable, inert persona descriptors for LLM priming. Conforms to BaseMetaDex v2.0 and requires an epistemic_core.",
  "allOf": [
    {
      "$ref": "base_metadex_v2.0.schema.pretty.json"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extensions"
      ],
      "properties": {
        "extensions": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "persona_metadex"
          ],
          "properties": {
            "persona_metadex": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "personas"
              ],
              "properties": {
                "schema_hint": {
                  "type": "string",
                  "const": "PersonaMetaDex-2.0",
                  "description": "Optional discriminator for tooling."
                },
                "intent": {
                  "type": "string",
                  "description": "High-level intent for how these personas are used (e.g., review, critique, examiner simulation)."
                },
                "personas": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "role",
                      "descriptor"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Optional stable identifier for this persona."
                      },
                      "name": {
                        "type": "string",
                        "description": "Display name of the persona."
                      },
                      "role": {
                        "type": "string",
                        "description": "Role label (e.g., 'Examiner', 'In-house counsel')."
                      },
                      "descriptor": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "summary",
                          "traits",
                          "boundaries"
                        ],
                        "properties": {
                          "summary": {
                            "type": "string",
                            "description": "One paragraph overview of the persona."
                          },
                          "traits": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string"
                            },
                            "description": "Key behavioral or stylistic traits."
                          },
                          "expertise": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Optional expertise areas relevant to the persona."
                          },
                          "incentives": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Optional incentives/drivers that shape perspective."
                          },
                          "biases": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Optional known biases or tendencies (explicitly described, not prescriptive)."
                          },
                          "boundaries": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "descriptive_only",
                              "no_authority",
                              "no_execution"
                            ],
                            "properties": {
                              "descriptive_only": {
                                "type": "boolean",
                                "const": true,
                                "description": "Personas are interpretive lenses only."
                              },
                              "no_authority": {
                                "type": "boolean",
                                "const": true,
                                "description": "Personas do not confer authority, priority, or override rights."
                              },
                              "no_execution": {
                                "type": "boolean",
                                "const": true,
                                "description": "Personas cannot execute actions or procedures."
                              },
                              "non_capabilities": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "Optional explicit list of non-capabilities to prevent misinterpretation."
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "description": "List of persona descriptors included in this PersonaMetaDex."
                },
                "interaction_model": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Optional descriptive framing for multi-persona use without prescribing procedures.",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "sequential",
                        "fishbowl_observational"
                      ],
                      "description": "Descriptive label for how personas may be invoked."
                    },
                    "notes": {
                      "type": "string",
                      "description": "Non-procedural notes about intended usage."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}