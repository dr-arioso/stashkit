{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stashkit.schemas/stashdex-1.0.1.schema.json",
  "title": "StashDex Schema v1.0.1 (Envelope)",
  "type": "object",
  "description": "StashDex is the umbrella schema for StashKit dex documents.\nA StashDex declares a stashdex header with a type and dialect.\nCurrently supported types: LexiDex and MetaDex.\n\nv1.0.1 updates embedded LexiDex schema to v3.4.1 (adds entity aliases in EPA dialect).",
  "oneOf": [
    {
      "$ref": "#/$defs/lexidex"
    },
    {
      "$ref": "#/$defs/metadex"
    }
  ],
  "$defs": {
    "lexidex": {
      "$id": "stashkit.schemas/lexidex-3.4.1.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "LexiDex Schema v3.4.1 (StashDex)",
      "description": "LexiDex v3.3 encodes domain ontology and graph-validity constraints: entities, predicates, optional axes, optional axioms, enums, and constraints. It is format- and tool-agnostic.\n\nv3.4 adds explicit StashDex header fields: stashdex.type and stashdex.dialect.\nLexiDex supports ontology dialects: epa.v1 and roots_nodes.v1.\n\nv3.4.1 adds optional entity_def.aliases for EPA dialect authoring convenience.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stashdex",
        "dex_identity",
        "dex_purpose",
        "ontology_core"
      ],
      "$defs": {
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_\\-\\.]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){0,3}([\\-+][A-Za-z0-9\\.\\-]+)?$"
        },
        "doc_ref": {
          "type": "object",
          "required": [
            "id",
            "title"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "enum_def": {
          "type": "object",
          "required": [
            "id",
            "values"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "doc": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "entity_def": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string"
            },
            "doc": {
              "type": "string"
            },
            "is_leaf": {
              "type": "boolean"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "predicate_def": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string"
            },
            "doc": {
              "type": "string"
            },
            "domain": {
              "$ref": "#/$defs/id"
            },
            "range": {
              "$ref": "#/$defs/id"
            },
            "range_kind": {
              "type": "string",
              "enum": [
                "entity",
                "enum",
                "scalar"
              ],
              "default": "entity"
            },
            "cardinality": {
              "type": "string",
              "enum": [
                "0..1",
                "1..1",
                "0..n",
                "1..n"
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "constraint_def": {
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "type": "string",
              "enum": [
                "required_predicate",
                "forbidden_predicate",
                "required_entity",
                "forbidden_entity",
                "cardinality",
                "enum_membership",
                "custom"
              ]
            },
            "subject": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ]
            },
            "doc": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "error",
                "warning"
              ],
              "default": "error"
            }
          },
          "additionalProperties": false
        },
        "ontology_block": {
          "oneOf": [
            {
              "$ref": "#/$defs/ontology_block_epa"
            },
            {
              "$ref": "#/$defs/ontology_block_roots_nodes"
            }
          ]
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "axiom_def": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "required_edge",
                "forbidden_edge",
                "implication",
                "equivalence",
                "subset",
                "disjoint",
                "custom"
              ],
              "description": "Ontology axiom kind (graph-semantics / validity), not behavior guidance."
            },
            "from": {
              "$ref": "#/$defs/id",
              "description": "Entity id (or node-set id) in subject position."
            },
            "via": {
              "$ref": "#/$defs/id",
              "description": "Predicate id for edge axioms."
            },
            "to": {
              "$ref": "#/$defs/id",
              "description": "Entity id (or node-set id) in object position."
            },
            "when": {
              "type": "string",
              "description": "Optional condition expression (project-defined)."
            },
            "then": {
              "type": "string",
              "description": "Optional consequence expression (project-defined)."
            },
            "cardinality": {
              "type": "string",
              "enum": [
                "0..1",
                "1..1",
                "0..n",
                "1..n"
              ]
            },
            "doc": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "error",
                "warning"
              ],
              "default": "error"
            }
          },
          "additionalProperties": false
        },
        "axis_def": {
          "type": "object",
          "required": [
            "id",
            "values"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "description": "Axis value set; use stable strings. (Alternative: reference an enum via enum_ref.)"
            },
            "enum_ref": {
              "$ref": "#/$defs/id",
              "description": "Optional enum id that supplies the values."
            },
            "order": {
              "type": "string",
              "enum": [
                "ordinal",
                "nominal"
              ],
              "default": "ordinal"
            },
            "doc": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "ontology_block_epa": {
          "type": "object",
          "required": [
            "entities",
            "predicates"
          ],
          "properties": {
            "entities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/entity_def"
              },
              "minItems": 1
            },
            "predicates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate_def"
              },
              "minItems": 1
            },
            "enums": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/enum_def"
              },
              "default": []
            },
            "constraints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/constraint_def"
              },
              "default": []
            },
            "docs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/doc_ref"
              },
              "default": []
            },
            "axioms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/axiom_def"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "ontology_block_roots_nodes": {
          "type": "object",
          "required": [
            "roots",
            "nodes",
            "predicates"
          ],
          "properties": {
            "roots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 1
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "name": {
                    "type": "string"
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "edges": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "via",
                        "to"
                      ],
                      "properties": {
                        "via": {
                          "$ref": "#/$defs/id"
                        },
                        "to": {
                          "$ref": "#/$defs/id"
                        },
                        "kind": {
                          "type": "string"
                        },
                        "meta": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "meta": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "docs": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "predicates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate_def"
              },
              "minItems": 1
            },
            "docs": {
              "type": "string"
            },
            "constraints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/constraint_def"
              },
              "default": []
            },
            "enums": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/enum_def"
              },
              "default": []
            }
          },
          "additionalProperties": false
        }
      },
      "properties": {
        "dex_identity": {
          "type": "object",
          "required": [
            "id",
            "name",
            "version"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "$ref": "#/$defs/version"
            },
            "hash": {
              "$ref": "#/$defs/sha256"
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "provisional",
                "complete",
                "deprecated"
              ],
              "default": "provisional"
            }
          },
          "additionalProperties": false
        },
        "dex_purpose": {
          "type": "object",
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string"
            },
            "non_goals": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "audience": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "ontology_core": {
          "$ref": "#/$defs/ontology_block"
        },
        "ontology_extended": {
          "$ref": "#/$defs/ontology_block"
        },
        "ontology_heavy": {
          "$ref": "#/$defs/ontology_block"
        },
        "docs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/doc_ref"
          },
          "default": []
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axis_def"
          },
          "default": []
        },
        "stashdex": {
          "type": "object",
          "required": [
            "type",
            "dialect"
          ],
          "properties": {
            "type": {
              "const": "LexiDex"
            },
            "dialect": {
              "type": "string",
              "enum": [
                "epa.v1",
                "roots_nodes.v1"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "defs": {
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_\\-\\.]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){0,3}([\\-+][A-Za-z0-9\\.\\-]+)?$"
        },
        "doc_ref": {
          "type": "object",
          "required": [
            "id",
            "title"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "enum_def": {
          "type": "object",
          "required": [
            "id",
            "values"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "doc": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "entity_def": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string"
            },
            "doc": {
              "type": "string"
            },
            "is_leaf": {
              "type": "boolean"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "predicate_def": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string"
            },
            "doc": {
              "type": "string"
            },
            "domain": {
              "$ref": "#/$defs/id"
            },
            "range": {
              "$ref": "#/$defs/id"
            },
            "range_kind": {
              "type": "string",
              "enum": [
                "entity",
                "enum",
                "scalar"
              ],
              "default": "entity"
            },
            "cardinality": {
              "type": "string",
              "enum": [
                "0..1",
                "1..1",
                "0..n",
                "1..n"
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "constraint_def": {
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "type": "string",
              "enum": [
                "required_predicate",
                "forbidden_predicate",
                "required_entity",
                "forbidden_entity",
                "cardinality",
                "enum_membership",
                "custom"
              ]
            },
            "subject": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ]
            },
            "doc": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "error",
                "warning"
              ],
              "default": "error"
            }
          },
          "additionalProperties": false
        },
        "ontology_block": {
          "type": "object",
          "required": [
            "entities",
            "predicates"
          ],
          "properties": {
            "entities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/entity_def"
              },
              "minItems": 1
            },
            "predicates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate_def"
              },
              "minItems": 1
            },
            "enums": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/enum_def"
              },
              "default": []
            },
            "constraints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/constraint_def"
              },
              "default": []
            },
            "docs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/doc_ref"
              },
              "default": []
            },
            "axioms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/axiom_def"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "axiom_def": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "required_edge",
                "forbidden_edge",
                "implication",
                "equivalence",
                "subset",
                "disjoint",
                "custom"
              ],
              "description": "Ontology axiom kind (graph-semantics / validity), not behavior guidance."
            },
            "from": {
              "$ref": "#/$defs/id",
              "description": "Entity id (or node-set id) in subject position."
            },
            "via": {
              "$ref": "#/$defs/id",
              "description": "Predicate id for edge axioms."
            },
            "to": {
              "$ref": "#/$defs/id",
              "description": "Entity id (or node-set id) in object position."
            },
            "when": {
              "type": "string",
              "description": "Optional condition expression (project-defined)."
            },
            "then": {
              "type": "string",
              "description": "Optional consequence expression (project-defined)."
            },
            "cardinality": {
              "type": "string",
              "enum": [
                "0..1",
                "1..1",
                "0..n",
                "1..n"
              ]
            },
            "doc": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "error",
                "warning"
              ],
              "default": "error"
            }
          },
          "additionalProperties": false
        },
        "axis_def": {
          "type": "object",
          "required": [
            "id",
            "values"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "description": "Axis value set; use stable strings. (Alternative: reference an enum via enum_ref.)"
            },
            "enum_ref": {
              "$ref": "#/$defs/id",
              "description": "Optional enum id that supplies the values."
            },
            "order": {
              "type": "string",
              "enum": [
                "ordinal",
                "nominal"
              ],
              "default": "ordinal"
            },
            "doc": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stashdex": {
                "properties": {
                  "dialect": {
                    "const": "epa.v1"
                  }
                },
                "required": [
                  "dialect"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "ontology_core": {
                "$ref": "#/$defs/ontology_block_epa"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stashdex": {
                "properties": {
                  "dialect": {
                    "const": "roots_nodes.v1"
                  }
                },
                "required": [
                  "dialect"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "ontology_core": {
                "$ref": "#/$defs/ontology_block_roots_nodes"
              }
            }
          }
        }
      ]
    },
    "metadex": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "stashkit.schemas/base_metadex-2.1.schema.json",
      "title": "BaseMetaDex Schema v2.1 (StashDex)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stashdex",
        "identity",
        "classification",
        "purpose",
        "epistemic_core"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "schema_version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional stable identifier for this MetaDex instance."
            },
            "name": {
              "type": "string",
              "description": "Canonical name for the MetaDex instance."
            },
            "version": {
              "type": "string",
              "description": "Version of this MetaDex instance (not the BaseMetaDex schema)."
            },
            "schema_version": {
              "type": "string",
              "const": "BaseMetaDex-2.0",
              "description": "BaseMetaDex schema version this instance conforms to."
            },
            "created_at": {
              "type": "string",
              "description": "Creation timestamp (ISO 8601)."
            },
            "updated_at": {
              "type": "string",
              "description": "Last updated timestamp (ISO 8601)."
            },
            "authors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional list of authors."
            },
            "license": {
              "type": "string",
              "description": "Optional license or usage note."
            },
            "derives_from": {
              "type": "string",
              "description": "Optional reference to a prior MetaDex/version."
            },
            "status": {
              "type": "string",
              "description": "Lifecycle status (draft, locked, deprecated, etc.)."
            }
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_type",
            "artifact_role",
            "artifact_scope"
          ],
          "properties": {
            "artifact_type": {
              "type": "string",
              "const": "MetaDex",
              "description": "Artifact class identifier."
            },
            "artifact_role": {
              "type": "string",
              "enum": [
                "descriptive"
              ],
              "description": "MetaDex is descriptive only; procedural control belongs elsewhere."
            },
            "artifact_scope": {
              "type": "string",
              "enum": [
                "conceptual"
              ],
              "description": "Scope of the MetaDex content."
            },
            "domain": {
              "type": "string",
              "description": "Optional domain label (e.g., patent, product, governance)."
            }
          }
        },
        "purpose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "intent"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "description": "One-sentence description of what this MetaDex is for."
            },
            "intent": {
              "type": "string",
              "description": "Short paragraph describing intended interpretive use."
            },
            "non_goals": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Explicit non-goals / exclusions."
            }
          }
        },
        "epistemic_contract": {
          "type": "object",
          "additionalProperties": false,
          "description": "Defines interpretive validity expectations for consumers. Declarative only (no instructions or procedures).",
          "properties": {
            "role": {
              "type": "string",
              "enum": [
                "interpretive_precondition"
              ],
              "default": "interpretive_precondition"
            },
            "interpretation_validity": {
              "type": "string",
              "default": "requires_epistemic_core"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "epistemic_core": {
          "type": "object",
          "additionalProperties": false,
          "description": "Constitutive core required to perturb default LLM reconstruction and prevent context-collapse.",
          "required": [
            "semantic_invariants",
            "non_equivalences",
            "assumption_surface_area"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "constitutive"
              ],
              "default": "constitutive"
            },
            "semantic_invariants": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "Global invariants that must remain true across interpretation."
            },
            "non_equivalences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "not_equivalent"
                ],
                "properties": {
                  "not_equivalent": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "string"
                    },
                    "description": "Two or more concepts that must not be collapsed as equivalent."
                  },
                  "rationale": {
                    "type": "string",
                    "description": "Optional rationale for the non-equivalence."
                  },
                  "risk_of_conflation": {
                    "type": "string",
                    "description": "Optional note about the typical mistaken inference."
                  }
                }
              },
              "description": "Non-equivalences marking common category errors."
            },
            "assumption_surface_area": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assumption",
                  "risk"
                ],
                "properties": {
                  "assumption": {
                    "type": "string",
                    "description": "A default assumption likely to be made by an LLM or reader."
                  },
                  "risk": {
                    "type": "string",
                    "description": "How that assumption breaks reconstruction or causes collapse."
                  },
                  "examples": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Optional examples of the failure mode."
                  }
                }
              },
              "description": "Named assumption pressure points where default epistemology misfires."
            }
          }
        },
        "extensions": {
          "type": "object",
          "description": "Optional extension namespace for domain-specific additions. Must remain descriptive/non-procedural.",
          "additionalProperties": true
        },
        "stashdex": {
          "type": "object",
          "required": [
            "type",
            "dialect"
          ],
          "properties": {
            "type": {
              "const": "MetaDex"
            },
            "subtype": {
              "type": "string"
            },
            "dialect": {
              "const": "metadex.v2"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
