{
  "$id": "stashkit.schemas/lexidex-3.4.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LexiDex Schema v3.4.1 (StashDex)",
  "description": "LexiDex v3.3 encodes domain ontology and graph-validity constraints: entities, predicates, optional axes, optional axioms, enums, and constraints. It is format- and tool-agnostic.\n\nv3.4 adds explicit StashDex header fields: stashdex.type and stashdex.dialect.\nLexiDex supports ontology dialects: epa.v1 and roots_nodes.v1.\n\nv3.4.1 adds optional entity_def.aliases for EPA dialect authoring convenience.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stashdex",
    "dex_identity",
    "dex_purpose",
    "ontology_core"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_\\-\\.]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,3}([\\-+][A-Za-z0-9\\.\\-]+)?$"
    },
    "doc_ref": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "enum_def": {
      "type": "object",
      "required": [
        "id",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "doc": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entity_def": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "doc": {
          "type": "string"
        },
        "is_leaf": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "predicate_def": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "doc": {
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/id"
        },
        "range": {
          "$ref": "#/$defs/id"
        },
        "range_kind": {
          "type": "string",
          "enum": [
            "entity",
            "enum",
            "scalar"
          ],
          "default": "entity"
        },
        "cardinality": {
          "type": "string",
          "enum": [
            "0..1",
            "1..1",
            "0..n",
            "1..n"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "constraint_def": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "required_predicate",
            "forbidden_predicate",
            "required_entity",
            "forbidden_entity",
            "cardinality",
            "enum_membership",
            "custom"
          ]
        },
        "subject": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "doc": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ],
          "default": "error"
        }
      },
      "additionalProperties": false
    },
    "ontology_block": {
      "oneOf": [
        {
          "$ref": "#/$defs/ontology_block_epa"
        },
        {
          "$ref": "#/$defs/ontology_block_roots_nodes"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "axiom_def": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "required_edge",
            "forbidden_edge",
            "implication",
            "equivalence",
            "subset",
            "disjoint",
            "custom"
          ],
          "description": "Ontology axiom kind (graph-semantics / validity), not behavior guidance."
        },
        "from": {
          "$ref": "#/$defs/id",
          "description": "Entity id (or node-set id) in subject position."
        },
        "via": {
          "$ref": "#/$defs/id",
          "description": "Predicate id for edge axioms."
        },
        "to": {
          "$ref": "#/$defs/id",
          "description": "Entity id (or node-set id) in object position."
        },
        "when": {
          "type": "string",
          "description": "Optional condition expression (project-defined)."
        },
        "then": {
          "type": "string",
          "description": "Optional consequence expression (project-defined)."
        },
        "cardinality": {
          "type": "string",
          "enum": [
            "0..1",
            "1..1",
            "0..n",
            "1..n"
          ]
        },
        "doc": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ],
          "default": "error"
        }
      },
      "additionalProperties": false
    },
    "axis_def": {
      "type": "object",
      "required": [
        "id",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "description": "Axis value set; use stable strings. (Alternative: reference an enum via enum_ref.)"
        },
        "enum_ref": {
          "$ref": "#/$defs/id",
          "description": "Optional enum id that supplies the values."
        },
        "order": {
          "type": "string",
          "enum": [
            "ordinal",
            "nominal"
          ],
          "default": "ordinal"
        },
        "doc": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ontology_block_epa": {
      "type": "object",
      "required": [
        "entities",
        "predicates"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity_def"
          },
          "minItems": 1
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate_def"
          },
          "minItems": 1
        },
        "enums": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enum_def"
          },
          "default": []
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_def"
          },
          "default": []
        },
        "docs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/doc_ref"
          },
          "default": []
        },
        "axioms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axiom_def"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "ontology_block_roots_nodes": {
      "type": "object",
      "required": [
        "roots",
        "nodes",
        "predicates"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "via",
                    "to"
                  ],
                  "properties": {
                    "via": {
                      "$ref": "#/$defs/id"
                    },
                    "to": {
                      "$ref": "#/$defs/id"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              },
              "meta": {
                "type": "object",
                "additionalProperties": true
              },
              "docs": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate_def"
          },
          "minItems": 1
        },
        "docs": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_def"
          },
          "default": []
        },
        "enums": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enum_def"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "dex_identity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "provisional",
            "complete",
            "deprecated"
          ],
          "default": "provisional"
        }
      },
      "additionalProperties": false
    },
    "dex_purpose": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string"
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "ontology_core": {
      "$ref": "#/$defs/ontology_block"
    },
    "ontology_extended": {
      "$ref": "#/$defs/ontology_block"
    },
    "ontology_heavy": {
      "$ref": "#/$defs/ontology_block"
    },
    "docs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/doc_ref"
      },
      "default": []
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "axes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/axis_def"
      },
      "default": []
    },
    "stashdex": {
      "type": "object",
      "required": [
        "type",
        "dialect"
      ],
      "properties": {
        "type": {
          "const": "LexiDex"
        },
        "dialect": {
          "type": "string",
          "enum": [
            "epa.v1",
            "roots_nodes.v1"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_\\-\\.]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,3}([\\-+][A-Za-z0-9\\.\\-]+)?$"
    },
    "doc_ref": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "enum_def": {
      "type": "object",
      "required": [
        "id",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "doc": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entity_def": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "doc": {
          "type": "string"
        },
        "is_leaf": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "predicate_def": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "doc": {
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/id"
        },
        "range": {
          "$ref": "#/$defs/id"
        },
        "range_kind": {
          "type": "string",
          "enum": [
            "entity",
            "enum",
            "scalar"
          ],
          "default": "entity"
        },
        "cardinality": {
          "type": "string",
          "enum": [
            "0..1",
            "1..1",
            "0..n",
            "1..n"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "constraint_def": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "required_predicate",
            "forbidden_predicate",
            "required_entity",
            "forbidden_entity",
            "cardinality",
            "enum_membership",
            "custom"
          ]
        },
        "subject": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "doc": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ],
          "default": "error"
        }
      },
      "additionalProperties": false
    },
    "ontology_block": {
      "type": "object",
      "required": [
        "entities",
        "predicates"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity_def"
          },
          "minItems": 1
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate_def"
          },
          "minItems": 1
        },
        "enums": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enum_def"
          },
          "default": []
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_def"
          },
          "default": []
        },
        "docs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/doc_ref"
          },
          "default": []
        },
        "axioms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axiom_def"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "axiom_def": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "required_edge",
            "forbidden_edge",
            "implication",
            "equivalence",
            "subset",
            "disjoint",
            "custom"
          ],
          "description": "Ontology axiom kind (graph-semantics / validity), not behavior guidance."
        },
        "from": {
          "$ref": "#/$defs/id",
          "description": "Entity id (or node-set id) in subject position."
        },
        "via": {
          "$ref": "#/$defs/id",
          "description": "Predicate id for edge axioms."
        },
        "to": {
          "$ref": "#/$defs/id",
          "description": "Entity id (or node-set id) in object position."
        },
        "when": {
          "type": "string",
          "description": "Optional condition expression (project-defined)."
        },
        "then": {
          "type": "string",
          "description": "Optional consequence expression (project-defined)."
        },
        "cardinality": {
          "type": "string",
          "enum": [
            "0..1",
            "1..1",
            "0..n",
            "1..n"
          ]
        },
        "doc": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ],
          "default": "error"
        }
      },
      "additionalProperties": false
    },
    "axis_def": {
      "type": "object",
      "required": [
        "id",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "description": "Axis value set; use stable strings. (Alternative: reference an enum via enum_ref.)"
        },
        "enum_ref": {
