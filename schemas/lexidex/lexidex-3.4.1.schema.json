  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stashdex": {
            "properties": {
              "dialect": {
                "const": "epa.v1"
              }
            },
            "required": [
              "dialect"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ontology_core": {
            "$ref": "#/$defs/ontology_block_epa"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stashdex": {
            "properties": {
              "dialect": {
                "const": "roots_nodes.v1"
              }
            },
            "required": [
              "dialect"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ontology_core": {
            "$ref": "#/$defs/ontology_block_roots_nodes"
          }
        }
      }
    }
  ]
}
