{
  "$id": "lexidex-3.2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LexiDex Schema v3.2 (Ontology-only + Axes/Axioms + Authoring Meta)",
  "description": "LexiDex v3.2 encodes only domain ontology and graph-validity constraints. It supports optional axes and axioms for compact, typed structural semantics. Authoring guidance is metadata-only (for generators) and does not constitute behavioral governance. LLM behavior/governance belongs in LLZen Charters and overlays.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dex_identity",
    "dex_purpose",
    "ontology_core"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_\\-\\.]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,3}([\\-+][A-Za-z0-9\\.\\-]+)?$"
    },
    "doc_ref": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "enum_def": {
      "type": "object",
      "required": [
        "id",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "doc": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entity_def": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "doc": {
          "type": "string"
        },
        "is_leaf": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "predicate_def": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "doc": {
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/id"
        },
        "range": {
          "$ref": "#/$defs/id"
        },
        "range_kind": {
          "type": "string",
          "enum": [
            "entity",
            "enum",
            "scalar"
          ],
          "default": "entity"
        },
        "cardinality": {
          "type": "string",
          "enum": [
            "0..1",
            "1..1",
            "0..n",
            "1..n"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "constraint_def": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "required_predicate",
            "forbidden_predicate",
            "required_entity",
            "forbidden_entity",
            "cardinality",
            "enum_membership",
            "custom"
          ]
        },
        "subject": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "doc": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ],
          "default": "error"
        }
      },
      "additionalProperties": false,
      "$comment": "Guideline: Avoid kind=custom in complete dexes. Prefer axioms[] for structured semantics. If custom is used, keep subject/value machine-interpretable."
    },
    "ontology_block": {
      "type": "object",
      "required": [
        "entities",
        "predicates"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity_def"
          },
          "minItems": 1
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate_def"
          },
          "minItems": 1
        },
        "enums": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enum_def"
          },
          "default": []
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_def"
          },
          "default": []
        },
        "docs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/doc_ref"
          },
          "default": []
        },
        "axioms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axiom_def"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "axiom_def": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "required_edge",
            "forbidden_edge",
            "implication",
            "equivalence",
            "subset",
            "disjoint",
            "custom"
          ],
          "description": "Ontology axiom kind (graph-semantics / validity), not behavior guidance."
        },
        "from": {
          "$ref": "#/$defs/id",
          "description": "Entity id (or node-set id) in subject position."
        },
        "via": {
          "$ref": "#/$defs/id",
          "description": "Predicate id for edge axioms."
        },
        "to": {
          "$ref": "#/$defs/id",
          "description": "Entity id (or node-set id) in object position."
        },
        "when": {
          "type": "string",
          "description": "Optional condition expression (project-defined)."
        },
        "then": {
          "type": "string",
          "description": "Optional consequence expression (project-defined)."
        },
        "cardinality": {
          "type": "string",
          "enum": [
            "0..1",
            "1..1",
            "0..n",
            "1..n"
          ]
        },
        "doc": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ],
          "default": "error"
        }
      },
      "additionalProperties": false,
      "$comment": "Normative: Axioms must be reducible to constraints deterministically (syntactic sugar). Avoid encoding behavioral guidance."
    },
    "axis_def": {
      "type": "object",
      "required": [
        "id",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "description": "Axis value set; use stable strings. (Alternative: reference an enum via enum_ref.)"
        },
        "enum_ref": {
          "$ref": "#/$defs/id",
          "description": "Optional enum id that supplies the values."
        },
        "order": {
          "type": "string",
          "enum": [
            "ordinal",
            "nominal"
          ],
          "default": "ordinal"
        },
        "doc": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "meta_def": {
      "type": "object",
      "required": [
        "authoring_preference",
        "axioms_reduce_to_constraints"
      ],
      "properties": {
        "authoring_preference": {
          "type": "string",
          "enum": [
            "axioms_first",
            "constraints_only",
            "mixed"
          ],
          "default": "axioms_first",
          "description": "Generator hint: prefer encoding structural semantics in axioms[] when available. This is not behavioral guidance; it is an authoring convention."
        },
        "axioms_reduce_to_constraints": {
          "type": "boolean",
          "const": true,
          "description": "Normative: axioms are syntactic sugar that can be lowered into constraints deterministically."
        },
        "custom_constraint_policy": {
          "type": "string",
          "enum": [
            "discouraged",
            "allowed_in_noncomplete_only",
            "allowed"
          ],
          "default": "allowed_in_noncomplete_only",
          "description": "Policy hint for generators and validators regarding constraint.kind=custom."
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "dex_identity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "provisional",
            "complete",
            "deprecated"
          ],
          "default": "provisional"
        }
      },
      "additionalProperties": false
    },
    "dex_purpose": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string"
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "ontology_core": {
      "$ref": "#/$defs/ontology_block"
    },
    "ontology_extended": {
      "$ref": "#/$defs/ontology_block"
    },
    "ontology_heavy": {
      "$ref": "#/$defs/ontology_block"
    },
    "docs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/doc_ref"
      },
      "default": []
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "axes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/axis_def"
      },
      "default": []
    },
    "meta": {
      "$ref": "#/$defs/meta_def"
    }
  },
