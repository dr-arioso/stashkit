  "allOf": [
    {
      "if": {
        "properties": {
          "ontology_core": {
            "properties": {
              "constraints": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "custom"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            },
            "required": [
              "constraints"
            ]
          }
        },
        "required": [
          "ontology_core"
        ]
      },
      "then": {
        "properties": {
          "dex_identity": {
            "properties": {
              "status": {
                "not": {
                  "const": "complete"
                }
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "dex_identity"
        ]
      },
      "$comment": "Disallow constraint.kind=custom in ontology_core when dex_identity.status == complete."
    },
    {
      "if": {
        "properties": {
          "ontology_extended": {
            "properties": {
              "constraints": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "custom"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            },
            "required": [
              "constraints"
            ]
          }
        },
        "required": [
          "ontology_extended"
        ]
      },
      "then": {
        "properties": {
          "dex_identity": {
            "properties": {
              "status": {
